<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="dynamic_human_zone">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Room boundary (5m x 5m) -->
    <model name="wall_n"><static>true</static><pose>0 2.5 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>5 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>5 0.05 0.8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>0 -2.5 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>5 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>5 0.05 0.8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>2.5 0 0.4 0 0 1.5708</pose>
      <link name="link"><collision name="c"><geometry><box><size>5 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>5 0.05 0.8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-2.5 0 0.4 0 0 1.5708</pose>
      <link name="link"><collision name="c"><geometry><box><size>5 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>5 0.05 0.8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>

    <!-- Human-proxy obstacles: cylinders sized roughly like standing people -->
    <!-- NOTE: these are STATIC stand-ins for people, not animated actors.
         True walking-actor animation needs Gazebo's online model DB (fuel.gazebosim.org),
         which your offline/remote setup may not reach. This still gives you a
         "human-occupied zone" density/spacing pattern distinct from Cluttered Room
         (fewer, larger, more spread-out obstacles vs many small boxes). -->
    <model name="person1"><static>true</static><pose>0.8 0.5 0.85 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry><material><ambient>0.9 0.7 0.6 1</ambient></material></visual></link></model>
    <model name="person2"><static>true</static><pose>-0.6 -0.7 0.85 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry><material><ambient>0.9 0.7 0.6 1</ambient></material></visual></link></model>
    <model name="person3"><static>true</static><pose>1.2 -1.0 0.85 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry><material><ambient>0.9 0.7 0.6 1</ambient></material></visual></link></model>
    <model name="person4"><static>true</static><pose>-1.3 1.1 0.85 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry><material><ambient>0.9 0.7 0.6 1</ambient></material></visual></link></model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
  </world>
</sdf>
