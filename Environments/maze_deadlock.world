<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="maze_deadlock">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Outer boundary (5m x 5m) -->
    <model name="wall_n"><static>true</static><pose>0 2.5 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>5 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>5 0.05 0.8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>0 -2.5 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>5 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>5 0.05 0.8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>2.5 0 0.4 0 0 1.5708</pose>
      <link name="link"><collision name="c"><geometry><box><size>5 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>5 0.05 0.8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-2.5 0 0.4 0 0 1.5708</pose>
      <link name="link"><collision name="c"><geometry><box><size>5 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>5 0.05 0.8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>

    <!-- Internal maze partitions forming a zigzag path with a dead-end pocket -->
    <model name="partition1"><static>true</static><pose>-1.0 1.0 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>3 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>3 0.05 0.8</size></box></geometry><material><ambient>0.5 0.5 0.7 1</ambient></material></visual></link></model>
    <model name="partition2"><static>true</static><pose>0.5 -0.2 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>3 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>3 0.05 0.8</size></box></geometry><material><ambient>0.5 0.5 0.7 1</ambient></material></visual></link></model>
    <model name="partition3"><static>true</static><pose>-0.8 -1.4 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>2.5 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>2.5 0.05 0.8</size></box></geometry><material><ambient>0.5 0.5 0.7 1</ambient></material></visual></link></model>
    <!-- Dead-end pocket wall: robot can enter but must backtrack (deadlock test) -->
    <model name="deadend_wall"><static>true</static><pose>1.7 1.5 0.4 0 0 1.5708</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.5 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.5 0.05 0.8</size></box></geometry><material><ambient>0.7 0.3 0.3 1</ambient></material></visual></link></model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
  </world>
</sdf>
