<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="narrow_corridor">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Left wall of corridor -->
    <model name="wall_left">
      <static>true</static>
      <pose>0 0.45 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.05 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.05 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Right wall of corridor (0.9m gap between walls) -->
    <model name="wall_right">
      <static>true</static>
      <pose>0 -0.45 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.05 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.05 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
  </world>
</sdf>
