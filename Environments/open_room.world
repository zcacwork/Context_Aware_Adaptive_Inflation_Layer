        <visual name="v"><geometry><box><size>6 0.05 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="spiral_2"><static>true</static><pose>3 0.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.05 5 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 5 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="spiral_3"><static>true</static><pose>0.5 -2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5 0.05 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 0.05 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="spiral_4"><static>true</static><pose>-2 0 0.4 0 0 0</pose>
