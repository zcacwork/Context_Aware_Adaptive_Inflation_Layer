<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="spiral_corridor">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <model name="spiral_1"><static>true</static><pose>0 3 0.4 0 0 0</pose>
      <link name="link">
