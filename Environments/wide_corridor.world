<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="wide_corridor">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Walls 1.8m apart (wide corridor) -->
    <model name="wall_left">
      <static>true</static>
      <pose>0 0.9 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.05 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.05 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="wall_right">
      <static>true</static>
      <pose>0 -0.9 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.05 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.05 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
  </world>
</sdf>
