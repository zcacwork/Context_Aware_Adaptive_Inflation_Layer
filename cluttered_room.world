<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="cluttered_room">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Outer boundary walls (6m x 6m room) -->
    <model name="wall_n"><static>true</static><pose>0 3 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>6 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6 0.05 0.8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>0 -3 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>6 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6 0.05 0.8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>3 0 0.4 0 0 1.5708</pose>
      <link name="link"><collision name="c"><geometry><box><size>6 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6 0.05 0.8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-3 0 0.4 0 0 1.5708</pose>
      <link name="link"><collision name="c"><geometry><box><size>6 0.05 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6 0.05 0.8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>

    <!-- Scattered clutter boxes: high obstacle density -->
    <model name="box1"><static>true</static><pose>1.0 1.2 0.25 0 0 0.3</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient></material></visual></link></model>
    <model name="box2"><static>true</static><pose>-0.8 0.9 0.25 0 0 0.6</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient></material></visual></link></model>
    <model name="box3"><static>true</static><pose>0.3 -1.0 0.25 0 0 1.1</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient></material></visual></link></model>
    <model name="box4"><static>true</static><pose>-1.5 -0.5 0.25 0 0 0.2</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient></material></visual></link></model>
    <model name="box5"><static>true</static><pose>1.8 -1.3 0.25 0 0 0.9</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient></material></visual></link></model>
    <model name="box6"><static>true</static><pose>-1.9 1.6 0.25 0 0 0.4</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient></material></visual></link></model>
    <model name="box7"><static>true</static><pose>0.6 2.0 0.25 0 0 0.7</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient></material></visual></link></model>
    <model name="box8"><static>true</static><pose>-0.5 -2.0 0.25 0 0 1.3</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient></material></visual></link></model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
  </world>
</sdf>
